      "cell_type": "code",
      "source": [
        "\n",
        "resultados = []\n",
        "\n",
        "for sku, datos in series_benchmark.items():\n",
        "    test = datos[\"test\"]\n",
        "    reales = pd.to_numeric(\n",
        "        test[objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    for metodo, pred in pronosticos_benchmark.get(sku, {}).items():\n",
        "        pred = np.asarray(pred, dtype=float)\n",
        "\n",
        "        # Comparar solo semanas con dato real y pronóstico válidos\n",
        "        validos = np.isfinite(reales) & np.isfinite(pred)\n",
        "        y = reales[validos]\n",
        "        yhat = pred[validos]\n",
        "\n",
        "        if len(y) == 0:\n",
        "            resultados.append({\n",
        "                \"SKU\": sku,\n",
        "                \"Benchmark\": metodo,\n",
        "                \"WAPE (%)\": np.nan,\n",
        "                \"Sesgo (cajas)\": np.nan,\n",
        "                \"Semanas evaluadas\": 0\n",
        "            })\n",
        "            continue\n",
        "\n",
        "        error_abs = np.abs(y - yhat).sum()\n",
        "        total_real = np.abs(y).sum()\n",
        "\n",
        "        wape = (\n",
        "            100 * error_abs / total_real\n",
        "            if total_real > 0 else np.nan\n",
        "        )\n",
        "\n",
        "        sesgo = np.mean(yhat - y)\n",
        "\n",
        "        resultados.append({\n",
        "            \"SKU\": sku,\n",
        "            \"Benchmark\": metodo,\n",
        "            \"WAPE (%)\": wape,\n",
        "            \"Sesgo (cajas)\": sesgo,\n",
        "            \"Semanas evaluadas\": len(y)\n",
        "        })\n",
        "\n",
        "tabla_benchmarks = pd.DataFrame(resultados)\n",
        "\n",
        "display(\n",
        "    tabla_benchmarks.sort_values(\n",
        "        [\"SKU\", \"WAPE (%)\"]\n",
        "    ).round(2)\n",
        ")\n"
      ],
