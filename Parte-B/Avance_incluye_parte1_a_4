    {
      "cell_type": "code",
      "source": [
        "\n",
        "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",
        "\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "horizonte = 13\n",
        "periodo_estacional = 52\n",
        "\n",
        "pronosticos_sarimax = {}\n",
        "ajustes_sarimax = {}\n",
        "errores_sarimax = []\n",
        "\n",
        "for sku, partes in series_ets.items():\n",
        "\n",
        "    train = partes[\"train\"].copy().sort_values(\"fecha_lunes\")\n",
        "    test = partes[\"test\"].copy().sort_values(\"fecha_lunes\")\n",
        "\n",
        "    # 1. Variable objetivo: demanda estimada\n",
        "    y_train = pd.to_numeric(\n",
        "        train[\"demanda_ets\"], errors=\"coerce\"\n",
        "    ).astype(float)\n",
        "\n",
        "    # Imputar faltantes usando únicamente el entrenamiento\n",
        "    for i in range(len(y_train)):\n",
        "        if pd.isna(y_train.iloc[i]):\n",
        "            vecinos = y_train.iloc[\n",
        "                max(0, i - 4):min(len(y_train), i + 5)\n",
        "            ].dropna()\n",
        "\n",
        "            if len(vecinos) >= 3:\n",
        "                y_train.iloc[i] = vecinos.median()\n",
        "\n",
        "    if y_train.isna().any():\n",
        "        mediana_y = y_train.median()\n",
        "        if pd.isna(mediana_y):\n",
        "            errores_sarimax.append({\n",
        "                \"SKU\": sku,\n",
        "                \"Error\": \"No hay datos suficientes de demanda\"\n",
        "            })\n",
        "            continue\n",
        "        y_train = y_train.fillna(mediana_y)\n",
        "\n",
        "    # 2. Preparar los regresores externos\n",
        "    precio_train = pd.to_numeric(\n",
        "        train[\"precio_efectivo_clp\"], errors=\"coerce\"\n",
        "    )\n",
        "    precio_test = pd.to_numeric(\n",
        "        test[\"precio_efectivo_clp\"], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    precio_base = precio_train.median()\n",
        "\n",
        "    if pd.isna(precio_base) or precio_base == 0:\n",
        "        errores_sarimax.append({\n",
        "            \"SKU\": sku,\n",
        "            \"Error\": \"No hay un precio base válido\"\n",
        "        })\n",
        "        continue\n",
        "\n",
        "    X_train = pd.DataFrame({\n",
        "        \"promocion\": pd.to_numeric(\n",
        "            train[\"promocion\"], errors=\"coerce\"\n",
        "        ),\n",
        "        \"precio_relativo\": precio_train / precio_base\n",
        "    }, index=train.index)\n",
        "\n",
        "    X_test = pd.DataFrame({\n",
        "        \"promocion\": pd.to_numeric(\n",
        "            test[\"promocion\"], errors=\"coerce\"\n",
        "        ),\n",
        "        \"precio_relativo\": precio_test / precio_base\n",
        "    }, index=test.index)\n",
        "\n",
        "    # Usar estadísticas del entrenamiento para faltantes\n",
        "    medianas_X = X_train.median()\n",
        "\n",
        "    X_train = X_train.fillna(medianas_X)\n",
        "    X_test = X_test.fillna(medianas_X)\n",
        "\n",
        "    if X_train.isna().any().any() or X_test.isna().any().any():\n",
        "        errores_sarimax.append({\n",
        "            \"SKU\": sku,\n",
        "            \"Error\": \"No se pudieron preparar los regresores\"\n",
        "        })\n",
        "        continue\n",
        "\n",
        "    # 3. Ajustar SARIMAX\n",
        "    try:\n",
        "        modelo = SARIMAX(\n",
        "            y_train.to_numpy(),\n",
        "            exog=X_train.to_numpy(),\n",
        "            order=(1, 0, 0),\n",
        "            seasonal_order=(1, 0, 0, periodo_estacional),\n",
        "            trend=\"c\",\n",
        "            enforce_stationarity=False,\n",
        "            enforce_invertibility=False\n",
        "        )\n",
        "\n",
        "        ajuste = modelo.fit(disp=False, maxiter=200)\n",
        "\n",
        "        # 4. Pronosticar las 13 semanas del test\n",
        "        prediccion = ajuste.get_forecast(\n",
        "            steps=len(test),\n",
        "            exog=X_test.to_numpy()\n",
        "        )\n",
        "\n",
        "        pronosticos_sarimax[sku] = {\n",
        "            \"media\": np.asarray(prediccion.predicted_mean),\n",
        "            \"lo_80\": np.asarray(prediccion.conf_int(alpha=0.20)[:, 0]),\n",
        "            \"hi_80\": np.asarray(prediccion.conf_int(alpha=0.20)[:, 1]),\n",
        "            \"lo_95\": np.asarray(prediccion.conf_int(alpha=0.05)[:, 0]),\n",
        "            \"hi_95\": np.asarray(prediccion.conf_int(alpha=0.05)[:, 1])\n",
        "        }\n",
        "\n",
        "        ajustes_sarimax[sku] = ajuste\n",
        "\n",
        "    except Exception as e:\n",
        "        errores_sarimax.append({\n",
        "            \"SKU\": sku,\n",
        "            \"Error\": str(e)\n",
        "        })\n",
        "\n",
        "print(\"SKU ajustados:\", len(pronosticos_sarimax))\n",
        "print(\"Pronósticos generados:\", sum(\n",
        "    len(v[\"media\"]) for v in pronosticos_sarimax.values()\n",
        "))\n",
        "\n",
        "print(\"\\nErrores:\")\n",
        "display(pd.DataFrame(errores_sarimax))\n"
      ],
