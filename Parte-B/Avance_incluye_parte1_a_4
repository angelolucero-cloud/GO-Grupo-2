    {
      "cell_type": "markdown",
      "source": [
        "Para utilizar los datos faltantes de CIT-L15, se usará una mediana local de una ventana de nueve semanas: la semana faltante y las cuatro semanas anteriores y posteriores. Para calcularla, se ignoran los valores faltantes y se utilizan solo observaciones que pertenecen al entrenamiento.\n",
        "\n"
      ],
      "metadata": {
        "id": "sHu8Xp4wCpfA"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "\n",
        "# Copias independientes para el entrenamiento de los modelos ETS\n",
        "series_ets = {}\n",
        "\n",
        "for sku, datos in series_benchmark.items():\n",
        "    train = datos[\"train\"].copy().sort_values(\"fecha_lunes\")\n",
        "    test = datos[\"test\"].copy().sort_values(\"fecha_lunes\")\n",
        "\n",
        "    train[\"demanda_ets\"] = pd.to_numeric(\n",
        "        train[objetivo], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    # Registrar cuáles eran los faltantes originales\n",
        "    train[\"imputado\"] = train[\"demanda_ets\"].isna()\n",
        "\n",
        "    if sku == \"CIT-L15\":\n",
        "        valores = train[\"demanda_ets\"].copy()\n",
        "\n",
        "        # Imputar solo faltantes y usando exclusivamente el entrenamiento\n",
        "        for idx in valores.index[valores.isna()]:\n",
        "            fecha = train.loc[idx, \"fecha_lunes\"]\n",
        "\n",
        "            ventana = train.loc[\n",
        "                (train[\"fecha_lunes\"] >= fecha - pd.Timedelta(weeks=4)) &\n",
        "                (train[\"fecha_lunes\"] <= fecha + pd.Timedelta(weeks=4)),\n",
        "                \"demanda_ets\"\n",
        "            ].dropna()\n",
        "\n",
        "            if len(ventana) >= 3:\n",
        "                valores.loc[idx] = ventana.median()\n",
        "            else:\n",
        "                # Respaldo: mediana global del entrenamiento disponible\n",
        "                mediana_train = train[\"demanda_ets\"].median()\n",
        "                if pd.notna(mediana_train):\n",
        "                    valores.loc[idx] = mediana_train\n",
        "\n",
        "        train[\"demanda_ets\"] = valores\n",
        "\n",
        "    series_ets[sku] = {\n",
        "        \"train\": train,\n",
        "        \"test\": test\n",
        "    }\n",
        "\n",
        "# Mostrar qué se imputó en CIT-L15\n",
        "cit = series_ets[\"CIT-L15\"][\"train\"]\n",
        "\n",
        "display(\n",
        "    cit.loc[\n",
        "        cit[\"imputado\"],\n",
        "        [\"fecha_lunes\", objetivo, \"demanda_ets\", \"imputado\"]\n",
        "    ]\n",
        ")\n"
