    {
      "cell_type": "markdown",
      "source": [
        "Se evaluó el modelo AutoARIMA para cada SKU utilizando los pronósticos generados para el período de prueba. Se calcularon las métricas WAPE, MASE y sesgo promedio (Bias), considerando únicamente las observaciones con valores reales y pronósticos disponibles. El WAPE cuantifica el error porcentual ponderado, mientras que el MASE compara el error medio con la variabilidad de la serie de entrenamiento, calculada mediante las diferencias absolutas entre observaciones consecutivas. El sesgo permite identificar tendencias de sobreestimación o subestimación. Finalmente, los resultados se consolidaron en una tabla comparativa por SKU."
      ],
      "metadata": {
        "id": "jptYNNSm4Hs7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "resultados_autoarima = []\n",
        "\n",
        "for sku, partes in series_ets.items():\n",
        "\n",
        "    test = partes[\"test\"].copy().sort_values(\"fecha_lunes\")\n",
        "\n",
        "    pred_sku = (\n",
        "        pronostico_autoarima[\n",
        "            pronostico_autoarima[\"unique_id\"] == sku\n",
        "        ]\n",
        "        .sort_values(\"ds\")\n",
        "    )\n",
        "\n",
        "    reales = pd.to_numeric(\n",
        "        test[objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    pred = pred_sku[\"AutoARIMA\"].to_numpy(dtype=float)\n",
        "\n",
        "    # Comparar por fecha y excluir valores reales faltantes\n",
        "    n = min(len(reales), len(pred))\n",
        "    reales = reales[:n]\n",
        "    pred = pred[:n]\n",
        "\n",
        "    validos = np.isfinite(reales) & np.isfinite(pred)\n",
        "    y_real = reales[validos]\n",
        "    y_pred = pred[validos]\n",
        "\n",
        "    if len(y_real) == 0:\n",
        "        continue\n",
        "\n",
        "    error_abs = np.abs(y_real - y_pred)\n",
        "    suma_real = np.sum(np.abs(y_real))\n",
        "\n",
        "    wape = (\n",
        "        error_abs.sum() / suma_real * 100\n",
        "        if suma_real > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    train = pd.to_numeric(\n",
        "        partes[\"train\"][objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    train = train[np.isfinite(train)]\n",
        "    escala = np.mean(np.abs(np.diff(train))) if len(train) >= 2 else np.nan\n",
        "\n",
        "    mase = (\n",
        "        error_abs.mean() / escala\n",
        "        if np.isfinite(escala) and escala > 0\n",
        "        else np.nan\n",
        "    )\n",
        "\n",
        "    resultados_autoarima.append({\n",
        "        \"SKU\": sku,\n",
        "        \"WAPE (%)\": wape,\n",
        "        \"MASE\": mase,\n",
        "        \"Bias (cajas)\": np.mean(y_pred - y_real),\n",
        "        \"Semanas evaluadas\": len(y_real)\n",
        "    })\n",
        "\n",
        "tabla_autoarima = pd.DataFrame(resultados_autoarima)\n",
        "\n",
        "display(tabla_autoarima.round(3))\n"
