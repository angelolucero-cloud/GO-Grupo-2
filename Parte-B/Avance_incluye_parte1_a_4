        "\n",
        "r = resultados_rolling.copy()\n",
        "\n",
        "# Errores de pronóstico\n",
        "r[\"Error\"] = r[\"Pronostico\"] - r[\"Real\"]\n",
        "r[\"Error_abs\"] = r[\"Error\"].abs()\n",
        "\n",
        "# Resumen por SKU y modelo\n",
        "metricas_wape = (\n",
        "    r.groupby([\"SKU\", \"Modelo\"])\n",
        "     .apply(\n",
        "         lambda g: pd.Series({\n",
        "             \"WAPE_pct\": (\n",
        "                 100 * g[\"Error_abs\"].sum() / g[\"Real\"].abs().sum()\n",
        "                 if g[\"Real\"].abs().sum() != 0 else np.nan\n",
        "             ),\n",
        "             \"Sesgo_cajas\": g[\"Error\"].mean(),\n",
        "             \"N_pronosticos\": len(g),\n",
        "             \"N_ventanas\": g[\"Ventana\"].nunique()\n",
        "         }),\n",
        "         include_groups=False\n",
        "     )\n",
        "     .reset_index()\n",
        "     .sort_values([\"SKU\", \"WAPE_pct\"])\n",
        ")\n",
        "\n",
