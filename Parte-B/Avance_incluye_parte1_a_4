        "    )\n",
        "\n",
        "    cv2 = (\n",
        "        (positivas.std(ddof=1) / positivas.mean()) ** 2\n",
        "        if len(positivas) >= 2 else np.nan\n",
        "    )\n",
        "\n",
        "    resumen_intermitencia.append({\n",
