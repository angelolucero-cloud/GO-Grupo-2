      "cell_type": "code",
      "source": [
        "\n",
        "# Partimos de los resultados que ya tienen la escala MASE\n",
        "r = resultados_rolling.copy()\n",
        "\n",
        "r[\"Error\"] = r[\"Pronostico\"] - r[\"Real\"]\n",
        "r[\"Error_abs\"] = r[\"Error\"].abs()\n",
        "\n",
        "r[\"Escala_MASE\"] = [\n",
        "    escalas_mase_corregidas[(sku, ventana)][\"Escala_MASE\"]\n",
        "    for sku, ventana in zip(r[\"SKU\"], r[\"Ventana\"])\n",
        "]\n",
        "\n",
        "r[\"Error_MASE\"] = r[\"Error_abs\"] / r[\"Escala_MASE\"]\n",
        "\n",
        "resumen_global = (\n",
        "    r.groupby([\"SKU\", \"Modelo\"])\n",
        "     .apply(\n",
        "         lambda g: pd.Series({\n",
        "             \"WAPE_pct\": (\n",
        "                 100 * g[\"Error_abs\"].sum() / g[\"Real\"].abs().sum()\n",
        "                 if g[\"Real\"].abs().sum() > 0 else np.nan\n",
        "             ),\n",
        "             \"MASE\": g[\"Error_MASE\"].mean(),\n",
        "             \"Sesgo_cajas\": g[\"Error\"].mean(),\n",
        "             \"N_pronosticos\": len(g),\n",
        "             \"N_ventanas\": g[\"Ventana\"].nunique()\n",
        "         }),\n",
        "         include_groups=False\n",
        "     )\n",
        "     .reset_index()\n",
        "     .sort_values([\"SKU\", \"WAPE_pct\"])\n",
        ")\n",
        "\n",
        "# Mostrar el mejor WAPE disponible por SKU, junto con las tres métricas\n",
        "mejores_por_sku = (\n",
        "    resumen_global.dropna(subset=[\"WAPE_pct\"])\n",
        "    .groupby(\"SKU\", as_index=False)\n",
        "    .first()\n",
        ")\n",
        "\n",
        "display(mejores_por_sku.round(3))\n"
