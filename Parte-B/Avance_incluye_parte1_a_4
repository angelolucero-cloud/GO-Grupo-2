        "## Se calcula el método benchmark drift o deriva este método proyecta la tendencia histórica de las ventas, calculando el cambio promedio entre la primera y la última observación del período de entrenamiento. A partir de esta variación, genera pronósticos para las siguientes 13 semanas, permitiendo comparar su desempeño con los métodos ingenuo simple e ingenuo estacional."
      ],
      "metadata": {
        "id": "px88nE1b2_qd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "for sku, datos in series_benchmark.items():\n",
        "    train = datos[\"train\"]\n",
        "\n",
        "    y_train = pd.to_numeric(\n",
        "        train[objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    pred_drift = np.full(horizonte, np.nan)\n",
        "\n",
        "    # Posiciones de las observaciones disponibles\n",
        "    posiciones_validas = np.where(np.isfinite(y_train))[0]\n",
        "\n",
        "    if len(posiciones_validas) >= 2:\n",
        "        primera_pos = posiciones_validas[0]\n",
        "        ultima_pos = posiciones_validas[-1]\n",
        "\n",
        "        primera_demanda = y_train[primera_pos]\n",
        "        ultima_demanda = y_train[ultima_pos]\n",
        "\n",
        "        distancia = ultima_pos - primera_pos\n",
        "\n",
        "        if distancia > 0:\n",
        "            deriva = (\n",
        "                (ultima_demanda - primera_demanda) / distancia\n",
        "            )\n",
        "\n",
        "            # Proyectar desde la última observación válida\n",
        "            posiciones_futuras = (\n",
        "                len(y_train) + np.arange(horizonte)\n",
        "            )\n",
        "\n",
        "            pred_drift = ultima_demanda + deriva * (\n",
        "                posiciones_futuras - ultima_pos\n",
        "            )\n",
        "\n",
        "    elif len(posiciones_validas) == 1:\n",
        "        # Con un solo dato no se puede estimar una tendencia;\n",
        "        # mantenemos ese nivel como pronóstico.\n",
        "        ultima_demanda = y_train[posiciones_validas[-1]]\n",
        "        pred_drift = np.repeat(ultima_demanda, horizonte)\n",
        "\n",
        "    pronosticos_benchmark[sku][\"Deriva (drift)\"] = pred_drift\n",
        "\n",
        "print(\"Benchmark deriva calculado.\")"
      ],
