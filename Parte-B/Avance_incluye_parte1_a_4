        "\n",
        "from statsforecast import StatsForecast\n",
        "from statsforecast.models import AutoARIMA\n",
        "\n",
        "horizonte = 13\n",
        "periodo_estacional = 52\n",
        "\n",
        "# Preparar los datos de entrenamiento de cada SKU\n",
        "datos_train = []\n",
        "\n",
        "for sku, partes in series_ets.items():\n",
        "\n",
        "    train = partes[\"train\"].sort_values(\n",
        "        \"fecha_lunes\"\n",
        "    ).copy().reset_index(drop=True)\n",
        "\n",
        "    y = pd.to_numeric(\n",
        "        train[\"demanda_ets\"], errors=\"coerce\"\n",
        "    ).astype(float)\n",
        "\n",
        "    # Imputar faltantes solo dentro del entrenamiento\n",
        "    for i in range(len(y)):\n",
        "        if pd.isna(y.iloc[i]):\n",
        "            vecinos = y.iloc[\n",
        "                max(0, i - 4):min(len(y), i + 5)\n",
        "            ].dropna()\n",
        "\n",
        "            if len(vecinos) >= 3:\n",
        "                y.iloc[i] = vecinos.median()\n",
        "\n",
        "    if y.isna().any():\n",
        "        mediana = y.median()\n",
        "\n",
        "        if pd.isna(mediana):\n",
        "            print(f\"Se omite {sku}: datos insuficientes\")\n",
        "            continue\n",
        "\n",
        "        y = y.fillna(mediana)\n",
        "\n",
        "    datos_train.append(pd.DataFrame({\n",
        "        \"unique_id\": sku,\n",
        "        \"ds\": pd.to_datetime(train[\"fecha_lunes\"]),\n",
        "        \"y\": y.to_numpy()\n",
        "    }))\n",
        "\n",
        "df_train = pd.concat(datos_train, ignore_index=True)\n",
        "\n",
        "# Ajustar AutoARIMA para las series semanales\n",
        "sf = StatsForecast(\n",
        "    models=[AutoARIMA(season_length=periodo_estacional)],\n",
        "    freq=\"W-MON\",\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "sf.fit(df_train)\n",
        "\n",
        "print(\"AutoARIMA ajustado para los SKU disponibles.\")\n",
        "print(\"Cantidad de SKU:\", df_train[\"unique_id\"].nunique())\n"
