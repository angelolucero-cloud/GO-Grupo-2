        "\n",
        "import warnings\n",
        "\n",
        "from statsmodels.tsa.holtwinters import (\n",
        "    SimpleExpSmoothing,\n",
        "    Holt,\n",
        "    ExponentialSmoothing\n",
        ")\n",
        "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",
        "from statsforecast import StatsForecast\n",
        "from statsforecast.models import AutoARIMA\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "H = 13\n",
        "INICIAL = 104\n",
        "PASO = 5\n",
        "M = 52\n",
        "\n",
        "# Candidatos ETS que ya veníamos evaluando\n",
        "ets_por_sku = {\n",
        "    \"CIT-L05\": [\"SES\"],\n",
        "    \"CIT-L15\": [\"SES\", \"HW_aditivo\"],\n",
        "    \"CIT-L30\": [\"SES\", \"HW_aditivo\"],\n",
        "    \"FUN-B05\": [\"SES\", \"Holt\", \"Holt_amortiguado\"],\n",
        "    \"FUN-B15\": [\"SES\", \"Holt\", \"Holt_amortiguado\"],\n",
        "    \"FUN-B30\": [\"SES\"],\n",
        "    \"NEC-D05\": [\"SES\", \"HW_aditivo\"],\n",
        "    \"NEC-D15\": [\"SES\"],\n",
        "    \"NEC-D30\": [\"SES\", \"HW_aditivo\"]\n",
        "}\n",
        "\n",
        "def preparar_y(y):\n",
        "    \"\"\"Imputa faltantes dentro del entrenamiento.\"\"\"\n",
        "    y = pd.Series(y, dtype=float).reset_index(drop=True)\n",
        "\n",
        "    for i in range(len(y)):\n",
        "        if pd.isna(y.iloc[i]):\n",
        "            vecinos = y.iloc[\n",
        "                max(0, i - 4):min(len(y), i + 5)\n",
        "            ].dropna()\n",
        "\n",
        "            if len(vecinos) >= 3:\n",
        "                y.iloc[i] = vecinos.median()\n",
        "\n",
        "    if y.isna().any():\n",
        "        mediana = y.median()\n",
        "        if pd.isna(mediana):\n",
        "            raise ValueError(\"Serie sin valores suficientes\")\n",
        "        y = y.fillna(mediana)\n",
        "\n",
        "    return y.to_numpy(dtype=float)\n",
        "\n",
        "\n",
        "resultados_rolling = []\n",
        "errores_rolling = []\n",
        "\n",
        "for sku, partes in series_ets.items():\n",
        "\n",
        "    datos = (\n",
        "        pd.concat([partes[\"train\"], partes[\"test\"]])\n",
        "        .sort_values(\"fecha_lunes\")\n",
        "        .drop_duplicates(\"fecha_lunes\")\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    # Objetivo y regresores ordenados cronológicamente\n",
        "    y_original = pd.to_numeric(\n",
        "        datos[objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    fechas = pd.to_datetime(datos[\"fecha_lunes\"])\n",
        "\n",
        "    # Las 8 ventanas deben caber en las 156 semanas\n",
        "    cortes = list(range(INICIAL, len(datos) - H + 1, PASO))[:8]\n",
        "\n",
        "    for numero_ventana, corte in enumerate(cortes, start=1):\n",
        "\n",
        "        y_train_original = y_original[:corte]\n",
        "        y_test = y_original[corte:corte + H]\n",
        "        fechas_test = fechas.iloc[corte:corte + H]\n",
        "\n",
        "        try:\n",
        "            y_train = preparar_y(y_train_original)\n",
        "        except Exception as e:\n",
        "            errores_rolling.append({\n",
        "                \"SKU\": sku, \"Ventana\": numero_ventana,\n",
        "                \"Modelo\": \"Preparación\", \"Error\": str(e)\n",
        "            })\n",
        "            continue\n",
        "\n",
        "        # Métricas MASE con escala estacional lag 52\n",
        "        escala = np.mean(\n",
        "            np.abs(y_train[M:] - y_train[:-M])\n",
        "        ) if len(y_train) > M else np.nan\n",
        "\n",
        "\n",
        "        # Modelos ingenuos\n",
        "\n",
        "        ingenuos = {\n",
        "            \"Ingenuo simple\": np.repeat(y_train[-1], H),\n",
        "            \"Ingenuo estacional\": y_train[-M:][:H]\n",
        "        }\n",
        "\n",
        "        # Deriva: tendencia entre primer y último valor\n",
        "        deriva = (\n",
        "            y_train[-1]\n",
        "            + np.arange(1, H + 1)\n",
        "            * (y_train[-1] - y_train[0]) / (len(y_train) - 1)\n",
        "        )\n",
        "        ingenuos[\"Deriva\"] = deriva\n",
        "\n",
        "        for nombre, pred in ingenuos.items():\n",
        "            for h in range(H):\n",
        "                resultados_rolling.append({\n",
        "                    \"SKU\": sku,\n",
        "                    \"Ventana\": numero_ventana,\n",
        "                    \"Corte\": fechas.iloc[corte - 1],\n",
        "                    \"Horizonte\": h + 1,\n",
        "                    \"Modelo\": nombre,\n",
        "                    \"Real\": y_test[h],\n",
        "                    \"Pronostico\": max(0, float(pred[h]))\n",
        "                })\n",
        "\n",
        "             # ETS\n",
        "\n",
        "        for nombre in ets_por_sku.get(sku, [\"SES\"]):\n",
        "            try:\n",
        "                if nombre == \"SES\":\n",
        "                    ajuste = SimpleExpSmoothing(\n",
        "                        y_train,\n",
        "                        initialization_method=\"estimated\"\n",
        "                    ).fit()\n",
        "\n",
        "                elif nombre == \"Holt\":\n",
        "                    ajuste = Holt(\n",
        "                        y_train,\n",
        "                        initialization_method=\"estimated\"\n",
        "                    ).fit()\n",
        "\n",
        "                elif nombre == \"Holt_amortiguado\":\n",
        "                    ajuste = Holt(\n",
        "                        y_train,\n",
        "                        damped_trend=True,\n",
        "                        initialization_method=\"estimated\"\n",
        "                    ).fit()\n",
        "\n",
        "                elif nombre == \"HW_aditivo\":\n",
        "                    ajuste = ExponentialSmoothing(\n",
        "                        y_train,\n",
        "                        trend=None,\n",
        "                        seasonal=\"add\",\n",
        "                        seasonal_periods=M,\n",
        "                        initialization_method=\"estimated\"\n",
        "                    ).fit()\n",
        "\n",
        "                pred = np.asarray(ajuste.forecast(H), dtype=float)\n",
        "\n",
        "                for h in range(H):\n",
        "                    resultados_rolling.append({\n",
        "                        \"SKU\": sku,\n",
        "                        \"Ventana\": numero_ventana,\n",
        "                        \"Corte\": fechas.iloc[corte - 1],\n",
        "                        \"Horizonte\": h + 1,\n",
        "                        \"Modelo\": nombre,\n",
        "                        \"Real\": y_test[h],\n",
        "                        \"Pronostico\": max(0, float(pred[h]))\n",
        "                    })\n",
        "\n",
        "            except Exception as e:\n",
        "                errores_rolling.append({\n",
        "                    \"SKU\": sku, \"Ventana\": numero_ventana,\n",
        "                    \"Modelo\": nombre, \"Error\": str(e)\n",
        "                })\n",
        "\n",
        "\n",
        "        # C. AutoARIMA\n",
        "\n",
        "        try:\n",
        "            df_arima = pd.DataFrame({\n",
        "                \"unique_id\": sku,\n",
        "                \"ds\": fechas.iloc[:corte].to_numpy(),\n",
        "                \"y\": y_train\n",
        "            })\n",
        "\n",
        "            sf_fold = StatsForecast(\n",
        "                models=[AutoARIMA(season_length=M)],\n",
        "                freq=\"W-MON\",\n",
        "                n_jobs=1\n",
        "            )\n",
        "\n",
        "            sf_fold.fit(df_arima)\n",
        "            fc = sf_fold.predict(h=H)\n",
        "            pred = fc[\"AutoARIMA\"].to_numpy(dtype=float)\n",
        "\n",
        "            for h in range(H):\n",
        "                resultados_rolling.append({\n",
        "                    \"SKU\": sku,\n",
        "                    \"Ventana\": numero_ventana,\n",
        "                    \"Corte\": fechas.iloc[corte - 1],\n",
        "                    \"Horizonte\": h + 1,\n",
        "                    \"Modelo\": \"AutoARIMA\",\n",
        "                    \"Real\": y_test[h],\n",
        "                    \"Pronostico\": max(0, float(pred[h]))\n",
        "                })\n",
        "\n",
        "        except Exception as e:\n",
        "            errores_rolling.append({\n",
        "                \"SKU\": sku, \"Ventana\": numero_ventana,\n",
        "                \"Modelo\": \"AutoARIMA\", \"Error\": str(e)\n",
        "            })\n",
        "\n",
        "\n",
        "        # D. SARIMAX con precio y promoción\n",
        "\n",
        "        try:\n",
        "            precio_train = pd.to_numeric(\n",
        "                datos[\"precio_efectivo_clp\"].iloc[:corte],\n",
        "                errors=\"coerce\"\n",
        "            ).reset_index(drop=True)\n",
        "\n",
        "            precio_test = pd.to_numeric(\n",
        "                datos[\"precio_efectivo_clp\"].iloc[corte:corte + H],\n",
        "                errors=\"coerce\"\n",
        "            ).reset_index(drop=True)\n",
        "\n",
        "            promo_train = pd.to_numeric(\n",
        "                datos[\"promocion\"].iloc[:corte],\n",
        "                errors=\"coerce\"\n",
        "            ).reset_index(drop=True)\n",
        "\n",
        "            promo_test = pd.to_numeric(\n",
        "                datos[\"promocion\"].iloc[corte:corte + H],\n",
        "                errors=\"coerce\"\n",
        "            ).reset_index(drop=True)\n",
        "\n",
        "            precio_base = precio_train.median()\n",
        "\n",
        "            if pd.isna(precio_base) or precio_base == 0:\n",
        "                raise ValueError(\"Precio base no válido\")\n",
        "\n",
        "            X_train = pd.DataFrame({\n",
        "                \"promocion\": promo_train,\n",
        "                \"precio_relativo\": precio_train / precio_base\n",
        "            })\n",
        "\n",
        "            X_test = pd.DataFrame({\n",
        "                \"promocion\": promo_test,\n",
        "                \"precio_relativo\": precio_test / precio_base\n",
        "            })\n",
        "\n",
        "            medianas = X_train.median()\n",
        "            X_train = X_train.fillna(medianas)\n",
        "            X_test = X_test.fillna(medianas)\n",
        "\n",
        "            if X_train.isna().any().any() or X_test.isna().any().any():\n",
        "                raise ValueError(\"Faltan valores en regresores\")\n",
        "\n",
        "            modelo = SARIMAX(\n",
        "                y_train,\n",
        "                exog=X_train.to_numpy(),\n",
        "                order=(1, 0, 0),\n",
        "                seasonal_order=(1, 0, 0, M),\n",
        "                trend=\"c\",\n",
        "                enforce_stationarity=False,\n",
        "                enforce_invertibility=False\n",
        "            )\n",
        "\n",
        "            ajuste = modelo.fit(disp=False, maxiter=200)\n",
        "\n",
        "            pred = np.asarray(\n",
        "                ajuste.get_forecast(\n",
        "                    steps=H,\n",
        "                    exog=X_test.to_numpy()\n",
        "                ).predicted_mean,\n",
        "                dtype=float\n",
