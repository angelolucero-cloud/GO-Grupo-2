        "\n",
        "    errores_abs = np.abs(y_real - y_pred)\n",
        "    suma_real = np.sum(np.abs(y_real))\n",
        "\n",
        "    wape = (\n",
        "        errores_abs.sum() / suma_real * 100\n",
        "        if suma_real > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    train_y = pd.to_numeric(\n",
        "        partes[\"train\"][objetivo], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "    train_y = train_y[np.isfinite(train_y)]\n",
        "\n",
        "    escala_mase = (\n",
        "        np.mean(np.abs(np.diff(train_y)))\n",
        "        if len(train_y) >= 2 else np.nan\n",
        "    )\n",
        "\n",
        "    mase = (\n",
