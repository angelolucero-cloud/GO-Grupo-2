        "        alertas[\"dias_sin_stock\"].isna(),\n",
        "        alertas[\"promocion\"].eq(1)\n",
        "        & alertas[\"dias_sin_stock\"].gt(0),\n",
        "        alertas[\"dias_sin_stock\"].gt(0),\n",
