      "cell_type": "markdown",
      "source": [
        "Se evaluó el desempeño de los modelos ETS para cada SKU utilizando los datos del período de prueba. Para ello, se calcularon las métricas WAPE y MASE, junto con el sesgo promedio (Bias). Los cálculos consideraron únicamente las semanas con valores reales y pronósticos disponibles. La escala del MASE se obtuvo a partir de las diferencias consecutivas de la serie de entrenamiento. Finalmente, se organizó una tabla comparativa por SKU y modelo, ordenada según el WAPE para facilitar la identificación preliminar de los modelos con menor error."
      ],
      "metadata": {
        "id": "jsjud0MT3vAF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "resultados_ets = []\n",
        "\n",
        "for sku, modelos in pronosticos_ets.items():\n",
        "\n",
        "    # Valores reales del periodo de prueba\n",
        "    test = series_ets[sku][\"test\"]\n",
        "    reales = test[objetivo].to_numpy(dtype=float)\n",
        "\n",
        "    # Métricas para cada modelo ETS\n",
        "    for nombre_modelo, pronostico in modelos.items():\n",
        "\n",
        "        pronostico = np.asarray(pronostico, dtype=float)\n",
        "\n",
        "        # Comparar solamente semanas con valores reales disponibles\n",
        "        validos = np.isfinite(reales) & np.isfinite(pronostico)\n",
        "\n",
        "        y_real = reales[validos]\n",
        "        y_pred = pronostico[validos]\n",
        "\n",
        "        if len(y_real) == 0:\n",
        "            continue\n",
        "\n",
        "        # WAPE\n",
        "        denominador_wape = np.sum(np.abs(y_real))\n",
        "        wape = (\n",
        "            np.sum(np.abs(y_real - y_pred)) / denominador_wape * 100\n",
        "            if denominador_wape > 0 else np.nan\n",
        "        )\n",
        "\n",
        "        # MASE: escala calculada con el entrenamiento\n",
        "        train = series_ets[sku][\"train\"][objetivo].to_numpy(dtype=float)\n",
        "        train_validos = train[np.isfinite(train)]\n",
        "\n",
        "        diferencias = np.abs(np.diff(train_validos))\n",
        "        escala_mase = np.mean(diferencias) if len(diferencias) else np.nan\n",
        "\n",
        "        mase = (\n",
        "            np.mean(np.abs(y_real - y_pred)) / escala_mase\n",
        "            if np.isfinite(escala_mase) and escala_mase > 0\n",
        "            else np.nan\n",
        "        )\n",
        "\n",
        "        # Bias positivo = sobreestimación; negativo = subestimación\n",
        "        bias = np.mean(y_pred - y_real)\n",
        "\n",
        "        resultados_ets.append({\n",
        "            \"SKU\": sku,\n",
        "            \"Modelo\": nombre_modelo,\n",
        "            \"WAPE (%)\": wape,\n",
        "            \"MASE\": mase,\n",
        "            \"Bias (cajas)\": bias,\n",
        "            \"Semanas evaluadas\": len(y_real)\n",
        "        })\n",
        "\n",
        "tabla_ets = pd.DataFrame(resultados_ets)\n",
        "\n",
        "display(\n",
        "    tabla_ets.sort_values([\"SKU\", \"WAPE (%)\"])\n",
        "    .round(3)\n",
        "    .reset_index(drop=True)\n",
        ")\n"
      ],
