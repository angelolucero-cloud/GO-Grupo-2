        "for sku, datos in series_benchmark.items():\n",
        "    train = datos[\"train\"].copy().sort_values(\"fecha_lunes\")\n",
        "    test = datos[\"test\"].copy().sort_values(\"fecha_lunes\")\n",
        "\n",
        "    train[\"demanda_ets\"] = pd.to_numeric(\n",
        "        train[objetivo], errors=\"coerce\"\n",
        "    )\n",
        "    train[\"imputado\"] = False\n",
        "\n",
        "    if sku == \"CIT-L15\":\n",
        "        # Identificar faltantes originales antes de imputar\n",
        "        faltantes = train[\"demanda_ets\"].isna()\n",
        "        train.loc[faltantes, \"imputado\"] = True\n",
        "\n",
        "        # Imputar cada faltante usando solo el entrenamiento\n",
        "        for idx in train.index[faltantes]:\n",
        "            fecha = train.loc[idx, \"fecha_lunes\"]\n",
        "\n",
        "            mascara = (\n",
        "                (train[\"fecha_lunes\"] >= fecha - pd.Timedelta(weeks=4)) &\n",
        "                (train[\"fecha_lunes\"] <= fecha + pd.Timedelta(weeks=4))\n",
        "            )\n",
        "\n",
        "            ventana = train.loc[\n",
        "                mascara & train[\"demanda_ets\"].notna(),\n",
        "                \"demanda_ets\"\n",
        "            ]\n",
        "\n",
        "            if len(ventana) >= 3:\n",
        "                estimacion = ventana.median()\n",
        "            else:\n",
        "                estimacion = train[\"demanda_ets\"].median()\n",
        "\n",
        "            if pd.notna(estimacion):\n",
        "                train.loc[idx, \"demanda_ets\"] = estimacion\n",
        "\n",
        "    series_ets[sku] = {\n",
        "        \"train\": train,\n",
        "        \"test\": test\n",
        "    }\n",
        "\n",
        "# Ajustar los modelos ETS\n",
        "pronosticos_ets = {}\n",
        "ajustes_ets = {}\n",
        "errores_ets = []\n",
        "\n",
        "for sku, datos in series_ets.items():\n",
        "    train = datos[\"train\"]\n",
        "    test = datos[\"test\"]\n",
        "\n",
        "    y = pd.to_numeric(\n",
        "        train[\"demanda_ets\"], errors=\"coerce\"\n",
        "    ).astype(float)\n",
        "\n",
        "    pronosticos_ets[sku] = {}\n",
        "    ajustes_ets[sku] = {}\n",
        "\n",
        "    for metodo in ets_por_sku.get(sku, [\"SES\"]):\n",
        "        try:\n",
        "            # No ajustar modelos si siguen existiendo NaN o infinitos\n",
        "            if not np.isfinite(y.to_numpy()).all():\n",
        "                raise ValueError(\n",
        "                    \"Persisten valores faltantes o infinitos \"\n",
        "                    \"en el entrenamiento.\"\n",
        "                )\n",
        "\n",
        "            if len(y) < 2:\n",
        "                raise ValueError(\"Entrenamiento insuficiente.\")\n",
        "\n",
        "            if metodo == \"SES\":\n",
        "                ajuste = SimpleExpSmoothing(\n",
        "                    y,\n",
        "                    initialization_method=\"estimated\"\n",
        "                ).fit(optimized=True)\n",
        "\n",
        "            elif metodo == \"Holt\":\n",
        "                ajuste = Holt(\n",
        "                    y,\n",
        "                    initialization_method=\"estimated\"\n",
        "                ).fit(optimized=True)\n",
        "\n",
        "            elif metodo == \"Holt_amortiguado\":\n",
        "                ajuste = Holt(\n",
        "                    y,\n",
        "                    damped_trend=True,\n",
        "                    initialization_method=\"estimated\"\n",
        "                ).fit(optimized=True)\n",
        "\n",
        "            elif metodo == \"HW_aditivo\":\n",
        "                if len(y) < 2 * periodo_estacional:\n",
        "                    raise ValueError(\n",
        "                        \"Se requieren al menos 104 observaciones \"\n",
        "                        \"para probar dos ciclos anuales completos.\"\n",
        "                    )\n",
        "\n",
        "                ajuste = ExponentialSmoothing(\n",
        "                    y,\n",
        "                    trend=\"add\",\n",
        "                    seasonal=\"add\",\n",
        "                    seasonal_periods=periodo_estacional,\n",
        "                    initialization_method=\"estimated\"\n",
        "                ).fit(optimized=True)\n",
        "\n",
        "            pred = np.asarray(\n",
        "                ajuste.forecast(len(test)),\n",
        "                dtype=float\n",
        "            )\n",
        "\n",
        "            pronosticos_ets[sku][metodo] = pred\n",
        "            ajustes_ets[sku][metodo] = ajuste\n",
        "\n",
        "        except Exception as e:\n",
        "            errores_ets.append({\n",
        "                \"SKU\": sku,\n",
        "                \"Método\": metodo,\n",
        "                \"Motivo\": str(e)\n",
        "            })\n",
        "\n",
        "print(\"Modelos ajustados correctamente:\")\n",
        "for sku, modelos in pronosticos_ets.items():\n",
