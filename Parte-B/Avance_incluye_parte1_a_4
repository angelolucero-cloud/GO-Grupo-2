        "\n",
        "\n",
        "r = resultados_rolling.copy()\n",
        "datos = demanda_censura.copy()\n",
        "\n",
        "# Asegurar tipos y orden temporal\n",
        "r[\"Corte\"] = pd.to_datetime(r[\"Corte\"])\n",
        "datos[\"fecha_lunes\"] = pd.to_datetime(datos[\"fecha_lunes\"])\n",
        "\n",
        "# Escoger el objetivo utilizado en los pronósticos\n",
        "objetivo = \"demanda_estimada_disponibilidad\"\n",
        "\n",
        "# Calcular la escala MASE por SKU y ventana\n",
        "escalas = {}\n",
        "\n",
        "for (sku, ventana, corte), grupo in r.groupby(\n",
        "    [\"SKU\", \"Ventana\", \"Corte\"]\n",
        "):\n",
        "    entrenamiento = datos[\n",
        "        (datos[\"sku\"] == sku) &\n",
        "        (datos[\"fecha_lunes\"] < corte)\n",
        "    ].sort_values(\"fecha_lunes\")\n",
        "\n",
        "    y = entrenamiento[objetivo].astype(float).to_numpy()\n",
        "\n",
        "    # Diferencia estacional de 52 semanas\n",
        "    if len(y) > 52:\n",
        "        diferencias = np.abs(y[52:] - y[:-52])\n",
        "        diferencias = diferencias[np.isfinite(diferencias)]\n",
        "        escala = diferencias.mean() if len(diferencias) else np.nan\n",
        "    else:\n",
        "        escala = np.nan\n",
        "\n",
        "    escalas[(sku, ventana)] = escala\n",
        "\n",
        "# Errores de pronóstico\n",
        "r[\"Error\"] = r[\"Pronostico\"] - r[\"Real\"]\n",
        "r[\"Error_abs\"] = r[\"Error\"].abs()\n",
        "\n",
        "r[\"Escala_MASE\"] = [\n",
        "    escalas.get((sku, ventana), np.nan)\n",
        "    for sku, ventana in zip(r[\"SKU\"], r[\"Ventana\"])\n",
        "]\n",
        "\n",
