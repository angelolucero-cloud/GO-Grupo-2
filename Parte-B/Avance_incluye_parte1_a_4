        "    ],\n",
        "    [\n",
        "        \"Stock desconocido\",\n",
        "        \"Promoción y días sin stock\",\n",
        "        \"Días sin stock\",\n",
        "        \"Promoción\"\n",
        "    ],\n",
        "    default=\"Sin promoción ni días sin stock\"\n",
        ")\n",
        "\n",
        "print(\"RESUMEN DE ALERTAS POR CONTEXTO\")\n",
        "display(\n",
        "    alertas.groupby([\"contexto\", \"direccion\"])\n",
        "    .size()\n",
        "    .rename(\"cantidad\")\n",
        "    .reset_index()\n",
        ")\n",
